{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lm846802297-bit/high-energy-theory-research/blob/main/docs/schemas/standards-adoption-v1.0.0.schema.json",
  "title":"Research standards adoption and task provenance records v1.0.0",
  "oneOf":[{"$ref":"#/$defs/standards_lock"},{"$ref":"#/$defs/task_provenance"},{"$ref":"#/$defs/validation_report"}],
  "$defs":{
    "sha40":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "profile":{"enum":["core-governance","research-compute","task-handoff","scientific-diff","research-quality-gate","calculation-result-archive","rcrps-v1.0.1","git-review-and-merge","document-review","referee-response-and-manuscript-synchronization","generated-figure-and-report"]},
    "standards_lock":{
      "type":"object","additionalProperties":false,
      "required":["lock_version","central_repository","standards_release","source_commit","adopted_at","adoption_pr","adopted_profiles","local_extensions","deviations"],
      "properties":{
        "lock_version":{"const":1},
        "central_repository":{"const":"lm846802297-bit/high-energy-theory-research"},
        "standards_release":{"type":["string","null"]},"source_commit":{"$ref":"#/$defs/sha40"},
        "adopted_at":{"type":"string","format":"date"},"adoption_pr":{"type":"string","format":"uri"},
        "adopted_profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profile"}},
        "local_extensions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","scope"],"properties":{"path":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}}},
        "deviations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["profile","requirement","rationale","approval_reference"],"properties":{"profile":{"$ref":"#/$defs/profile"},"requirement":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},"approval_reference":{"type":"string","minLength":1},"review_by":{"type":"string","format":"date"}}}}
      }
    },
    "task_provenance":{
      "type":"object","additionalProperties":false,
      "required":["record_type","provenance_version","task_id","repository","task_brief_path","task_brief_sha256","central_repository","central_commit_sha","lock_file_path","lock_file_sha256","applied_profiles","project_extensions","acceptance_criteria"],
      "properties":{
        "record_type":{"const":"task_provenance"},"provenance_version":{"const":"1.0.0"},
        "task_id":{"type":"string","pattern":"^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "task_brief_path":{"type":"string","minLength":1},"task_brief_sha256":{"$ref":"#/$defs/sha256"},
        "central_repository":{"const":"lm846802297-bit/high-energy-theory-research"},"central_commit_sha":{"$ref":"#/$defs/sha40"},
        "lock_file_path":{"type":"string","minLength":1},"lock_file_sha256":{"$ref":"#/$defs/sha256"},
        "applied_profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profile"}},
        "project_extensions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","scope"],"properties":{"path":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}}},
        "acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    },
    "validation_report":{
      "type":"object","additionalProperties":false,
      "required":["record_type","report_version","task_id","repository","source_commit","central_commit_sha","status","checks"],
      "properties":{
        "record_type":{"const":"standards_validation_report"},"report_version":{"const":"1.0.0"},
        "task_id":{"type":"string","minLength":1},"repository":{"type":"string","minLength":3},
        "source_commit":{"$ref":"#/$defs/sha40"},"central_commit_sha":{"$ref":"#/$defs/sha40"},
        "status":{"enum":["COMPLIANT","NON_COMPLIANT","INCOMPLETE"]},
        "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["check_id","status","evidence"],"properties":{"check_id":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","BLOCKED","NOT_APPLICABLE"]},"evidence":{"type":"array","items":{"type":"string"}},"details":{"type":"string"}}}}
      }
    }
  }
}
